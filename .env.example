# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER put the real key in this file.

# --- Azure OpenAI (values from the GN assessment brief, including the API key) ---
AZURE_OPENAI_ENDPOINT=https://external-api.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna-c1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Mock Ticketing API (used by the agent and MCP server) ---
TICKET_API_BASE_URL=http://127.0.0.1:8000

# --- PR review bot ---
# Uses the AZURE_OPENAI_* values above. A local --dry-run needs no GitHub token;
# in GitHub Actions the workflow passes the built-in GITHUB_TOKEN.
